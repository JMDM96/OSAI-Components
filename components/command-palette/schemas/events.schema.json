{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "opened": {
      "type": "object",
      "properties": { "instanceId": { "type": "string" } },
      "required": ["instanceId"],
      "additionalProperties": false
    },
    "closed": {
      "type": "object",
      "properties": {
        "instanceId": { "type": "string" },
        "reason": { "enum": ["host", "escape", "selection", "shortcut", "button"] }
      },
      "required": ["instanceId", "reason"],
      "additionalProperties": false
    },
    "queryChanged": {
      "type": "object",
      "properties": {
        "instanceId": { "type": "string" },
        "query": { "type": "string" },
        "resultCount": { "type": "integer", "minimum": 0 }
      },
      "required": ["instanceId", "query", "resultCount"],
      "additionalProperties": false
    },
    "commandSelected": {
      "type": "object",
      "properties": {
        "instanceId": { "type": "string" },
        "commandId": { "type": "string" },
        "query": { "type": "string" },
        "source": { "enum": ["keyboard", "pointer"] }
      },
      "required": ["instanceId", "commandId", "query", "source"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "instanceId": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["instanceId", "code", "message"],
      "additionalProperties": false
    }
  }
}
